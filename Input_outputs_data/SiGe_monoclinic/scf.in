&control
    calculation      = 'scf'
    restart_mode     = 'from_scratch'
    prefix           = 'sige'
    pseudo_dir       = '../../../pseudo'
    outdir           = './tmpr'
/
&system
    ibrav           = 0
    nat             = 32
    ntyp            = 2
    ecutwfc         = 50
    ecutrho         = 400
    occupations      = 'smearing'
    smearing         = 'gauss'
    degauss          = 0.005
/
&electrons
    diagonalization  = 'david'
    mixing_mode      = 'plain'
    mixing_beta      = 0.4
    conv_thr         = 1.0d-10
    electron_maxstep = 300
/ 
&IONS 
/
